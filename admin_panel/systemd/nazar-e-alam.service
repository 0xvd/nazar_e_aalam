[Unit]
Description=Nazar-e-Aalam API
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=notify
User=oxvd
Group=oxvd
WorkingDirectory=/home/oxvd/mydata/nazar_e_alam/admin_panel
Environment="PATH=/home/oxvd/mydata/nazar_e_alam/admin_panel/.venv/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-/home/oxvd/mydata/nazar_e_alam/admin_panel/.env

# Migrations run synchronously before the app starts
ExecStartPre=/home/oxvd/mydata/nazar_e_alam/admin_panel/.venv/bin/alembic upgrade head

ExecStart=/home/oxvd/mydata/nazar_e_alam/admin_panel/.venv/bin/gunicorn \
    main:app -c gunicorn.conf.py
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=true
Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nazar-e-alam

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/oxvd/mydata/nazar_e_alam/admin_panel/logs
ReadWritePaths=/home/oxvd/mydata/nazar_e_alam/admin_panel/backups
ReadWritePaths=/home/oxvd/mydata/nazar_e_alam/admin_panel/downloads
ReadWritePaths=/home/oxvd/mydata/nazar_e_alam/admin_panel/sync_state.json

[Install]
WantedBy=multi-user.target