# =========================================================================== #
#  Nazar-e-Aalam Admin — environment variables
#  Copy this file to `.env` and adjust. Never commit `.env`.
# =========================================================================== #

# ---- App -------------------------------------------------------------------
APP_NAME=Nazar-e-Aalam Admin
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0
APP_URL=nazareaalam.dpdns.org
APP_PORT=8000

# ---- Database --------------------------------------------------------------
# mysqlclient:    mysql+mysqldb://user:pass@host:3306/db
# PyMySQL:        mysql+pymysql://user:pass@host:3306/db  (recommended)
# SQLite (dev):   sqlite:///./nazar_e_alam.db
DATABASE_URL=mysql+pymysql://root:hello123@localhost:3306/nazar_e_alam
SQL_ECHO=false

MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=Back shortly — scheduled maintenance

# ---- JWT / auth ------------------------------------------------------------
# Generate a secure key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=J7EzlLN63JWQ5ZKByF_MBU1cqx6JVX_icN3kJBRYSTrnL66Noi_OPw31JRYI_Pw1cZf4sGciGyvTrmBOrnPfnw
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=nazar-e-aalam

# ---- Initial admin seed ----------------------------------------------------
# Used on first run to create the super admin. Change before deploying!
INITIAL_ADMIN_EMAIL=naiemahemad888@gmail.com
INITIAL_ADMIN_PASSWORD=Naiem.214@123
INITIAL_ADMIN_FIRST_NAME=Naiem
INITIAL_ADMIN_LAST_NAME=Ahemad

# ---- Password hashing ------------------------------------------------------
# bcrypt cost factor. 12 for production, 10 for local development.
BCRYPT_ROUNDS=12

# ---- CORS ------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,https://nazareaalam.dpdns.org,https://www.nazareaalam.dpdns.org
CORS_ALLOW_CREDENTIALS=true

# ---- Cookies (for refresh token if delivered as httpOnly cookie) -----------
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# ---- Cache -----------------------------------------------------------------
# memory | redis
CACHE_BACKEND=memory
CACHE_DEFAULT_TTL=300

# Only used when CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ---- Uploads / media -------------------------------------------------------
UPLOAD_DIR=./uploads
MEDIA_URL=/media
MAX_UPLOAD_SIZE_MB=10

# ---- Email (password reset, notifications) ---------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO

SYNC_QURAN_ON_STARTUP=true
QURAN_MAX_GB=5.5
QURAN_MAX_PER_RECITER_GB=2.0

R2_PUBLIC_BASE_URL=https://pub-a6956026193d4c129f336af2cf887e0d.r2.dev
R2_BUCKET=nazar-e-alam
R2_ACCOUNT_ID=609b695064bdc10fad1f2755bc59658f
R2_ACCESS_KEY_ID=19e2136a00d03330a471e3ec0a6dada2
R2_SECRET_ACCESS_KEY=b82e65bdbad9563ec5f5b65ccf83eb5b2caa4fddbd00c1a7dae27c65688138fd


CHAND_SCHEDULER_ENABLED=true

R2_BACKUP_BUCKET=nazar-e-alam-backups
R2_BACKUP_ACCESS_KEY_ID=1aeaef2d5f677ee6883ce044b74019e9
R2_BACKUP_ACCESS_KEY=92c6bc9358e4c3d1b43329acc25d407a92fc922faca6faf74805edda7bf6319d

# ---- Backup scheduler (in-app) -------------------------------------------
# The app runs backups on its own thread. Set to false if you rely solely on cron.
BACKUP_AUTO_ENABLED=true
BACKUP_AUTO_HOUR=3
BACKUP_AUTO_MINUTE=0

LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
